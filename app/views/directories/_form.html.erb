<%= form_for [@directory.category, @directory], builder: DefiniteFormBuilder do |f| %>
  <%= f.error_messages %>
  <dl>
    <%= f.text_field :name %>
    <%= f.text_area :description %>

    <%= f.collection_select :roles, Role.all, :id, :display_name, { :selected => @directory.role_ids }, { :style => 'width:300px', :multiple => true, :name => 'directory[role_ids][]' } %>

    <%= f.submit %>
  </dl>
<% end %>
