
<% if (can?(:create, AttachedFile)) && false == AttachedFile::memory_exceeded? %>

<p class="horizontal-menu"><%= link_to t("activerecord.actions.create_new", :model => t("activerecord.models.attached_file")), new_category_directory_attached_file_path(@directory.category, @directory), class: 'add icon' %></p>

<% end %>

<%= paginate @attached_files if @attached_files.present? %>

<table class='autolink'>
  <tr>
    <th><%= sortable :filename, AttachedFile.human_attribute_name(:filename) %></th>
    <th><%= sortable :size, AttachedFile.human_attribute_name(:size) %></th>
    <th></th>
  </tr>
  <% @attached_files.each do |attached_file| %>
    <tr>
      <td><%= attached_file.filename %></td>
      <td><%= number_to_human_size(attached_file.size, :precision => 1, :significant => false) %></td>
      <td>
        <%= file_io_link_to download_category_directory_attached_file_path(attached_file.directory.category, attached_file.directory, attached_file) if can?(:file_io_link, attached_file) %>
        
        <%= show_link_to download_category_directory_attached_file_path(attached_file.directory.category, attached_file.directory, attached_file) if can?(:show, attached_file) %>
        <%= image_link_tag_helper 'show', category_directory_attached_file_path(attached_file.directory.category, attached_file.directory, attached_file), :title => I18n.t('helpers.link.show') %>
        <%= edit_link_to attached_file.path_array if can?(:edit, attached_file) %>
        <%= destroy_link_to attached_file.path_array if can?(:destroy, attached_file) %>
      </td>
    </tr>
  <% end %>
</table>

<%= paginate @attached_files if @attached_files.present? %>
