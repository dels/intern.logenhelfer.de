<% title t("activerecord.models.seeker") %>

<% if can? :create, Seeker %>
<p class="horizontal-menu"><%= link_to t("activerecord.actions.create_new", :model => t("activerecord.models.seeker")), new_seeker_path %></p>
<% end %>

  <%= paginate @seekers if @seekers.present? %>
<table  class='autolink'>
  <tr>
    <th><%= sortable :firstname, Seeker.human_attribute_name(:firstname) %></th>
    <th><%= sortable :lastname, Seeker.human_attribute_name(:lastname) %></th>
    <th><%= sortable :source, Seeker.human_attribute_name(:source) %></th>
    <th><%= sortable :preferred_way_of_contact, Seeker.human_attribute_name(:preferred_way_of_contact) %></th>
    <th><%= sortable :status, Seeker.human_attribute_name(:status) %></th>
    <th><%= sortable :updated_at, Seeker.human_attribute_name(:updated_at) %></th>
    <th></th>
  </tr>
  <% @seekers.each do |seeker| %>
    <tr>
      <td><%= seeker.firstname %></td>
      <td><%= seeker.lastname %></td>
      <td><%= seeker.source %></td>
      <td><%= dash(seekers_contact_data(seeker)) %></td>
      <td><%= dash(seeker.current_status) %></td>
      <td><%= l(seeker.updated_at, format: :date_only) %></td>
      <td>
        <%= show_link_to seeker if can?(:show, seeker) %>
        <%= edit_link_to seeker if can?(:edit, seeker) %>
        <%= destroy_link_to seeker if can?(:destroy, seeker) %>
      </td>
    </tr>
  <% end %>
</table>
<%= paginate @seekers if @seekers.present? %>
