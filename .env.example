# --- dev stack (docker-compose.yml): local postgres container ---
# Consumed by both the postgres container and the api. POSTGRES_DB must equal
# POSTGRES_USER: the postgres image only auto-creates a database matching
# POSTGRES_USER on first boot (no POSTGRES_DB is passed to the postgres-db
# container itself) - `prisma migrate deploy` (unlike Rails' db:prepare)
# never creates the database itself, so a mismatch here means the api can
# never connect on a fresh volume.
POSTGRES_USER=logenhelferuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logenhelferdb

# --- production stack (docker-compose.production.yml): external database ---
# DB_URL=postgres://DB_USERNAME:DB_PASSWORD@DB_HOST:5432/DB_NAME

# --- Secrets (required for prod/production) ---
# JWT_SECRET=            # generate with: openssl rand -hex 32
#
# MFA_ENCRYPTION_KEY, BIRTHDAY_CALENDAR_SECRET, and STATUS_ENDPOINT_TOKEN are
# NOT listed here on purpose - all three are auto-provisioned for a named
# .env.<env> (bin/init-env for a brand-new environment, bin/deploy-to for an
# already-live one) rather than hand-set, so they intentionally never appear
# as a settable line in the per-environment template blocks below. See
# CLAUDE.md's MFA section and README.md's uptime monitoring section for
# details.
#
# None of that auto-provisioning touches this root .env, though - it's only
# ever hand-copied (see CLAUDE.md's worktree note), and infra/docker-compose.yml
# only supplies a fixed dev-only fallback for the `docker compose up` path,
# not for host-side tooling that loads this file directly (api/test/setup.ts,
# Playwright's webServer). If a root .env predates one of these three vars,
# expect host-side `pnpm test`/`pnpm e2e` runs to fail loudly on whichever
# feature reads it (this has already happened once for
# BIRTHDAY_CALENDAR_SECRET) - fix by generating your own value by hand with
# `openssl rand -hex 32` and adding e.g. `STATUS_ENDPOINT_TOKEN=<value>` to
# this file, same format bin/init-env itself uses.

# JWT token lifetimes (optional - both default if unset; see
# api/src/auth/tokenConfig.ts).
# JWT_ACCESS_TTL=900          # seconds (default 15 min)
# JWT_REFRESH_TTL=604800      # seconds (default 7 days)
# RESET_PASSWORD_TOKEN_TTL=3600  # seconds (default 60 min); see api/src/auth/tokenConfig.ts

# Frontend idle-timeout (optional - defaults if unset; see
# app/src/auth/useIdleTimeout.ts). Unlike JWT_ACCESS_TTL/JWT_REFRESH_TTL
# above, this is NOT read by the running api process at container-start
# time - Vite bakes import.meta.env.VITE_* values in at FRONTEND BUILD time
# (see app/Dockerfile's ARG/ENV plumbing and docker-compose.production.yml's
# frontend build.args, mirroring GIT_HASH's existing build-arg pattern).
# Changing this on an already-built image has no effect until the frontend
# image is rebuilt.
# VITE_IDLE_TIMEOUT_MINUTES=30   # minutes of no click/keydown before auto-logout

# --- Mail (used to notify announcement subscribers - see api/src/lib/mail.ts).
# MAIL_TRANSPORT=console (or unset with no SMTP_HOST) logs instead of
# sending - the default for local dev/test. Set MAIL_TRANSPORT=smtp (and the
# SMTP_* vars below) to actually send. SMTP_HOST is the mail server hostname
# (e.g. smtp.example.com), not an email address. The From: address is
# configured separately in Settings > Konfiguration (default_from_email),
# not via env var. ---
# MAIL_TRANSPORT=console
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# --- Redis (optional - backs the outbound-mail job queue). One Redis
# instance is meant to be shared across every environment on a host, the
# same way Postgres already is (see DB_URL above) - not a per-environment
# container. Provisioned once, by hand, outside any environment's compose
# file; leave all five vars unset for local dev/test, which sends mail
# synchronously instead (no queue, no Redis needed). REDIS_PROTOCOL is
# "redis" or "rediss" (TLS) - use "rediss" for anything reachable over the
# open internet. ---
# REDIS_PROTOCOL=rediss
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=6379
# DEPLOY_NAME=          # required whenever the Redis vars above are set -
#                 identifies this environment for the mail queue's
#                 per-environment queue name (mail-logenhelfer-<DEPLOY_NAME>-queue).
#                 No other runtime mechanism distinguishes named
#                 environments (NODE_ENV is "production" for all of them).
#                 Must match the <env> this environment's .env.<env> file is
#                 named for - bin/deploy-to checks this on every deploy.

# --- api (TypeScript/Express/Prisma) --- shares this root .env, no api-specific
# .env of its own. docker-compose.yml's "api" service builds its own
# DATABASE_URL from the POSTGRES_* vars above (pointed at the postgres-db
# container); api/test/setup.ts derives the same DATABASE_URL from those
# same vars for host-side tooling (pnpm --filter api test running outside
# Docker), swapping in the host-mapped port (POSTGRES_PORT) instead of the
# container-internal one - no separate DATABASE_URL to keep in sync here.
# Set DATABASE_URL explicitly only to point host-side tooling at some other
# Postgres entirely.
# DATABASE_URL=
# Rate limits: centrally configurable, same defaults as the login throttle
# api/src/authz enforces.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# RATE_LIMIT_PASSWORD_RESET_MAX=5
# RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=60000
# RATE_LIMIT_STATUS_MAX=60
# RATE_LIMIT_STATUS_WINDOW_MS=60000

# Optional tuning
# API_PORT=3000         # host port the api listens on for local `docker compose up` (dev only —
                         # named/prod environments never publish api's port at all, see CLAUDE.md)
# POSTGRES_PORT=55432   # host port for the dev postgres (127.0.0.1 only)
# ICS_SYNC_INTERVAL_HOURS=24  # how often the api process re-syncs every external ICS calendar source in the background (api/src/lib/icsSyncScheduler.ts)
# MAX_UPLOAD_FILE_SIZE_MB=20  # optional, default 20 - the hard ceiling for
#                 uploads. Both nginx's client_max_body_size (edge and app's
#                 own nginx, infra/edge/default.conf.template and
#                 app/nginx.conf.template) and the api's multer buffering
#                 limit (contractValidation.ts's MULTIPART_FILE_SIZE_LIMIT_BYTES)
#                 derive from this single value, so they can no longer
#                 silently drift apart. The *actual* enforced limit is
#                 separately admin-configurable, anywhere from 0 up to this
#                 ceiling, via Settings > AppConfig max_upload_file_size — no
#                 deploy needed for that part.

# ============================================================================
# Per-environment config — one self-contained .env.<name> file per
# environment (e.g. .env.next, .env.prod), holding BOTH deploy orchestration
# (where to SSH to) AND runtime secrets (DB/JWT/mail/container names). This
# local file is the SOURCE OF TRUTH: bin/deploy-to pushes it to the deploy
# host before every deploy (backing up and pruning the previous copy there
# first) — nobody hand-edits .env.<name> on a host again. Scaffold a new one
# with `bin/init-env <name>` (auto-generates JWT_SECRET/DB password, prompts
# for the rest), or copy the template block below by hand.
#
# bin/deploy-to accepts ANY name matching ^[a-z0-9-]+$ that has a local
# .env.<name> file — there is no fixed list of allowed environment names.
# Adding a new lodge environment is: one manual `git clone` of this repo's
# own origin remote into a fresh directory on its deploy host (bin/deploy-to
# does not bootstrap a directory from nothing — its own error messages read
# the origin URL via `git config --get remote.origin.url`, not from .env),
# then `bin/init-env <lodge-name>` locally, then `bin/deploy-to <lodge-name>`.
# ============================================================================

# --- .env.next: the active preview environment today ---
# DEPLOY_HOST=example-host.example.com
# DEPLOY_USER=deploy
# DEPLOY_PATH=/home/deploy/git/dev/example-app-next
# DEPLOY_SSH_PORT=22
# ERROR_PAGES_PATH=/srv/logenhelfer-errors/next  # optional - path on this
#                  env's deploy host where bin/deploy-to rsyncs
#                  app/public/errors/ after every successful deploy, so the
#                  host's TLS-terminating nginx can serve them while the edge
#                  container itself is down. Unset (the default) skips this
#                  rsync step entirely. Must match whatever path gets pasted
#                  into infra/host-nginx-reference/logenhelfer.location.conf.example
#                  on the host.
# DB_URL=postgres://DB_USERNAME:DB_PASSWORD@DB_HOST:5432/logenhelfer_next
# JWT_SECRET=            # generate with: openssl rand -hex 32
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# RATE_LIMIT_PASSWORD_RESET_MAX=5
# RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=60000
# MAIL_TRANSPORT=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# REDIS_PROTOCOL=rediss  # optional, see the generic Redis section above
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=6379
# DEPLOY_NAME=
# VITE_IDLE_TIMEOUT_MINUTES=30
# ADMIN_USER=              # optional - email for a cross-lodge support login,
#                 not tied to any Member/Brother record. Both this and
#                 ADMIN_PASSWORD must be set together, or both left unset -
#                 see api/src/lib/adminAccount.ts. Changing ADMIN_PASSWORD
#                 and redeploying rotates the login on next boot. If this
#                 email collides with an existing member's email who isn't
#                 already an Admin, the api refuses to start rather than
#                 silently overwriting that member's password.
# ADMIN_PASSWORD=
# API_CONTAINER_NAME=logenhelfer-api-next
# APP_CONTAINER_NAME=logenhelfer-app-next
# Required, same as API/APP above - bin/deploy-to used to default this to
# a bare "edge" if absent, which is exactly what let two environments on a
# shared host both want a container named "edge". The blue/green slot
# containers themselves (logenhelfer-api-next-blue/-green, logenhelfer-app-next-blue/-green)
# aren't separately configured - bin/deploy-to derives their names from
# API_CONTAINER_NAME/APP_CONTAINER_NAME plus a -blue/-green suffix at deploy
# time. Keep this value line free of inline comments - bin/deploy-to
# extracts it with `grep '^EDGE_CONTAINER_NAME=' | cut -d= -f2-`, not bash
# `source`, so a trailing "# ..." comment would become part of the
# container name.
# EDGE_CONTAINER_NAME=logenhelfer-edge-next
# APP_PORT=9003
# APP_LISTEN_IP=  # only set if TLS-terminating host nginx is NOT this same
#                 # machine — point it at this host's WireGuard tunnel IP
#                 # instead of the 127.0.0.1 default (see README)

# --- .env.demo: public product demo at intern.logenhelfer.de ---
# Self-contained Postgres (infra/docker-compose.demo.yml) - no shared-host
# DB_HOST/role/database needed. Data resets on every deploy (see
# api/src/lib/demoSeed.ts) - never point this at a real lodge's database.
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_PATH=
# DEPLOY_SSH_PORT=22
# COMPOSE_EXTRA_FILES=docker-compose.demo.yml
# POSTGRES_USER=logenhelfer_demo
# POSTGRES_PASSWORD=            # generate with: openssl rand -base64 24 | tr -dc 'A-Za-z0-9'
# POSTGRES_DB=logenhelfer_demo
# DB_URL=postgresql://logenhelfer_demo:<same as POSTGRES_PASSWORD above>@postgres-db:5432/logenhelfer_demo
# JWT_SECRET=            # generate with: openssl rand -hex 32
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# MAIL_TRANSPORT=console
# REDIS_PROTOCOL=rediss  # optional, see the generic Redis section above
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=6379
# DEPLOY_NAME=
# DEMO_MODE=true         # gates api/src/lib/demoSeed.ts's reset/reseed,
#                 the read-only max_db_mem_size lock, and the frontend's
#                 permanent demo banner - see
#                 docs/superpowers/specs/2026-07-30-demo-environment-design.md
# API_CONTAINER_NAME=logenhelfer-api-demo
# APP_CONTAINER_NAME=logenhelfer-app-demo
# EDGE_CONTAINER_NAME=logenhelfer-edge-demo
# APP_PORT=

