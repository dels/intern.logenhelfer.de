<%- if user_signed_in? -%>
  <ul>
    <li><%= t "devise.information.signed_in_as", user: current_user.email %></li>
    <li class="space-bottom"><%= link_to t("devise.links.sign_out"), destroy_user_session_path %></li>
    <li>
      <ul>
        <%- if can? :create, Category -%>
          <%= content_tag :li, class: (request.fullpath =~ /^\/categories$/ ? 'active' : nil) do -%>
            <%= link_to t("activerecord.models.cateories"), categories_path -%>
          <%- end -%>
        <%- end -%>

        <%= authorized_menu_item AppConfig, app_config_path do -%>
          <%- if request.fullpath =~ /^\/app_config/ -%>
            <%= content_tag :li, class: (request.fullpath =~ /^\/app_config\/roles/ ? 'active' : nil) do -%>
              <%= link_to t("activerecord.models.roles"), roles_path -%>
            <%- end -%>
          <%- end -%>
        <%- end -%>
        
        <%- if (request.fullpath =~ /^\/statistics/) || current_user.admin? || current_user.worshipful_master? || current_user.secretary? || current_user.net_delegate? -%>
          <%= authorized_menu_item Statistic, statistics_path do -%>
            <%- if request.fullpath =~ /^\/statistics/ -%>
              <%- if can? :mem_stats, Statistic -%>
                <%= content_tag :li, class: (request.fullpath =~ /^\/statistics\/mem_stats/ ? 'active' : nil) do -%>
                  <%= link_to t("helpers.pages.mem_stats"), mem_stats_statistics_path -%>
                <%- end -%>
              <%- end -%>
              <%- if can? :user_stats, Statistic -%>
                <%= content_tag :li, class: (request.fullpath =~ /^\/statistics\/user_stats/ ? 'active' : nil) do -%>
                  <%= link_to t("helpers.pages.user_stats"), user_stats_statistics_path -%>
                <%- end -%>
              <%- end -%>
              <%- if can? :downloads, Statistic -%>
                <%= content_tag :li, class: (request.fullpath =~ /^\/statistics\/downloads/ ? 'active' : nil) do -%>
                  <%= link_to t("helpers.pages.downloads"), downloads_statistics_path -%>
               <%- end -%>
              <%- end -%>
              <%- if can? :file_stats, Statistic -%>
                <%= content_tag :li, class: (request.fullpath =~ /^\/statistics\/file_stats/ ? 'active' : nil) do -%>
                  <%= link_to t("helpers.pages.file_stats"), file_stats_statistics_path -%>
                <%- end -%>
              <%- end -%>
              <%- if can? :user_file_stats, Statistic -%>
                <%= content_tag :li, class: (request.fullpath =~ /^\/statistics\/user_file_stats/ ? 'active' : nil) do -%>
                  <%= link_to t("helpers.pages.user_file_stats"), user_file_stats_statistics_path -%>
                <%- end -%>
              <%- end -%>
            <%- end -%>
          <%- end -%>
        <%- end -%>
      </ul>

      <ul class="space-top">
        <%= authorized_menu_item Announcement, announcements_path do -%>
        <%- if request.fullpath =~ /^\/announcements/ && can?(:manage, Announcement) -%>
        <%= content_tag :li, class: (request.fullpath =~ /^\/announcements\/new/ ? 'active' : nil) do -%>
        <%= link_to t("helpers.link.new"), new_announcement_path -%>
        <%- end -%>
        <%- end -%>
        <%- end -%>
      </ul>

      <ul class="space-top">
        <%= authorized_menu_item Lodge, lodges_path do -%>
          <%- if request.fullpath =~ /^\/lodges/ -%>
             <%= lodges_menu %>
           <%- end -%>
        <%- end -%>
      </ul>


      <ul class="space-top">
        <%= authorized_menu_item Event, upcoming_calendar_path do -%>
          <%- if request.fullpath =~ /^\/(events|calendar)/ -%>
            <%= content_tag :li, class: (request.fullpath =~ /^\/(events|calendar)\/public_workingplan/ ? 'active' : nil) do -%>
              <%= link_to t("helpers.pdf.public_workingplan"), public_workingplan_path -%>
            <%- end -%>
            <%= content_tag :li, class: (request.fullpath =~ /^\/(events|calendar)\/internal_workingplan/ ? 'active' : nil) do -%>
              <%= link_to t("helpers.pdf.internal_workingplan"), internal_workingplan_path -%>
            <%- end -%>
            <%= content_tag :li, class: (request.fullpath =~ /^\/(events|calendar)\/external_events/ ? 'active' : nil) do -%>
              <%= link_to t("activerecord.models.external_events"), external_events_path -%>
            <%- end -%>
          <%- end -%>
        <%- end -%>

        <%= authorized_menu_item User, users_path do -%>
          <%- if request.fullpath =~ /^\/users/ -%>
            <%= content_tag(:li, class: (request.fullpath =~ /^\/users\/members_list/ ? 'active' : '')) do -%>
              <%= link_to(t("helpers.pdf.memberslist"), members_list_users_path) -%>
            <%- end -%>
            <%= content_tag(:li, class: (request.fullpath =~ /^\/users\/members_of_council/ ? 'active' : '')) do -%>
              <%= link_to(t("helpers.pages.members_of_council"), members_of_council_users_path) -%>
            <%- end -%>
            <%= content_tag(:li, class: (request.fullpath =~ /^\/users\/phone_list/ ? 'active' : '')) do -%>
              <%= link_to(t("helpers.pdf.phonelist"), phone_list_users_path) -%>
            <%- end -%>
            <%= content_tag(:li, class: (request.fullpath =~ /^\/users\/birthday_list/ ? 'active' :'')) do -%>
              <%= link_to(t("helpers.pdf.birthdaylist"), birthday_list_users_path) -%>
              <%- end -%>
              <%= content_tag(:li, class: (request.fullpath =~ /^\/users\/google_sync/ ? 'active space-bottom' : 'space-bottom')) do -%>
              <%= link_to(t("contact_sync.title"), google_sync_users_path) -%>
            <%- end -%>
          <%- end -%>
          <%- end -%>
          
        <%= authorized_menu_item Seeker, seekers_path do -%>
          <%- if request.fullpath =~ /^\/seekers/ -%>
            <%= content_tag :li, class: (request.fullpath =~ /^\/seekers\/accepted/ ? 'active' : nil) do -%>
              <%= link_to t("helpers.pages.accepted_seekers"), accepted_seekers_path -%>
            <%- end -%>
            <%= content_tag :li, class: (request.fullpath =~ /^\/seekers\/inactive/ ? 'active' : nil) do -%>
              <%= link_to t("helpers.pages.inactive_seekers"), inactive_seekers_path -%>
            <%- end -%>
            <%= content_tag :li, class: (request.fullpath =~ /^\/seekers\/declined/ ? 'active' : nil) do -%>
              <%= link_to t("helpers.pages.declined_seekers"), declined_seekers_path -%>
            <%- end -%>
          <%- end -%>
        <%- end -%>
      </ul>

      <ul class="space-top"><%= categories_menu %></ul>
    </li>
  </ul>
<%- else -%>
  <ul>
    <%= content_tag :li, link_to(AppConfig[:lodge], root_url) -%>
    <%= content_tag :li, link_to(t("devise.links.sign_in"), new_user_session_path) -%>
  </ul>
<%- end -%>
