<% title @category.name %>

<p class="horizontal-menu">
  <%= edit_link_to @category if can?(:edit, @category) %>
  <%= destroy_link_to @category if can?(:destroy, @category) %>
  <%= show_link_to_all Category if can?(:index, Category) %>
</p>

<dl>
  <dt><%= t 'activerecord.attributes.category.description' %>:</dt>
  <dd><%= dash @category.description %></dd>
  
  <dt><%= t 'activerecord.attributes.category.roles' %>:</dt>
  <dd><ul>
    <% @category.roles.each do |role| %>
      <li><%= role.name %></li>
    <% end %>
  </ul></dd>
</dl>

</dl>

<p>&nbsp;</p>

<h2><%= t("activerecord.models.directories") %></h2>

<% if can?(:edit, @category)%>
  <%= render "directories/listing", :category => @category %>
<% end %>


