<% if can? :create, Directory %>
<p class="horizontal-menu"><%= link_to t("activerecord.actions.create_new", :model => t("activerecord.models.directory")), new_category_directory_path(category), class: 'add icon' %></p>
<% end %>

<%= paginate @directories if @directories.present? %>

<table class='autolink'>
  <tr>
    <th><%= sortable :name, Directory.human_attribute_name(:name) %></th>
    <th><%= Directory.human_attribute_name(:description) %></th>
    <th></th>
  </tr>
  <% @directories.each do |directory| %>
    <tr>
      <td><%= directory.name %></td>
      <td><%= directory.description %></td>
      <td>
        <%= show_link_to([directory.category, directory]) if can?(:show, directory) %>
        <%= edit_link_to([directory.category, directory]) if can?(:edit, directory) %>
        <%= destroy_link_to([directory.category, directory]) if can?(:destroy, directory) %>
      </td>
    </tr>
  <% end %>
</table>

<%= paginate @directories if @directories.present? %>
