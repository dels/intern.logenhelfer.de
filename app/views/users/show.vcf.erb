BEGIN:VCARD
VERSION:3.0
CLASS:CONFIDENTIAL
N:<%= @user.lastname %>; <%= @user.firstname %>
FN:<%= @user.fullname %>
ORG:<%= APP_CONFIG[:organisation] %>
URL:http://<%= APP_CONFIG[:domain] %>/
EMAIL;TYPE=INTERNET:<%= @user.email %>
<% @user.addresses.each do |addr| %>
<% unless addr.phone.empty? %>
TEL;TYPE=voice,<%= addr.vcf_type %>:<%= addr.phone %>
<% end %>
<% unless addr.mobile.empty? %>
TEL;TYPE=voice,cell,<%= addr.vcf_type %>:<%= addr.mobile %>
<% end %>
<% unless addr.fax.empty? %>
TEL;TYPE=fax,<%= addr.vcf_type %>:<%= addr.fax %>
<% end %>
<% unless addr.street.empty? %>
ADR;TYPE=postal,parcel,<%= addr.vcf_type %>:;;<%= addr.street %>;<%= addr.city %>;;<%= addr.zip %>;
<% end %>
<% if addr.remarks && false == addr.remarks.empty? %>
NOTE:<%= addr.remarks %>
<% end %>
<% end %>
END:VCARD