<% title @attached_file.filename %>

<p class="horizontal-menu">
  <%= edit_link_to @attached_file.path_array if can?(:edit, @attached_file) %>
  <%= destroy_link_to @attached_file.path_array if can?(:destroy, @attached_file) %>
  <%= show_link_to_all [@attached_file.directory.category, @attached_file.directory] if can?(:show, @attached_file.directory) %>
  <%= image_link_tag_helper "disk", download_category_directory_attached_file_path(@attached_file.directory.category, @attached_file.directory, @attached_file) %>
</p>

<dl>
  <dt><%= t 'activerecord.attributes.attached_file.filename' %>:</dt>
  <dd><%= @attached_file.filename %></dd>
  <dt><%= t 'activerecord.attributes.attached_file.content_type' %>:</dt>
  <dd><%= @attached_file.content_type %></dd>
  <dt><%= t 'activerecord.attributes.attached_file.directory' %>:</dt>
  <dd><%= @attached_file.directory.name %></dd>
  <dt><%= t 'activerecord.attributes.attached_file.uploader' %>:</dt>
  <dd><%= @attached_file.uploader.email rescue dash %></dd>
  <dt><%= t 'activerecord.attributes.attached_file.created_at' %>:</dt>
  <dd><%= l @attached_file.created_at %></dd>
  <dt><%= t 'activerecord.attributes.attached_file.updated_at' %>:</dt>
  <dd><%= l @attached_file.updated_at %></dd>

  <dt><%= t 'activerecord.attributes.attached_file.roles' %>:</dt>
  <dd><ul>
    <% @attached_file.roles.each do |role| %>
      <li><%= role %></li>
    <% end %>
  </ul></dd>

</dl>
