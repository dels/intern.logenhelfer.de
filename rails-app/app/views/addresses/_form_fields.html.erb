<div class="fields">

  <p>
    <%= link_to_remove_fields t('helpers.links.remove'), f, :addresses %>
    <%= f.hidden_field :_destroy %>
  </p>
  <dl>
    <%= f.select :type_of_address, Address::TYPES.to_a.map{|k,v| [I18n.t("activerecord.address.#{k}"), v]}, { include_blank: true }, data: { placeholder: I18n.t('helpers.select.prompt') }, class: "type_of_address" %>
    <%= f.text_field :purpose, placeholder: Address.human_attribute_name(:purpose_info) %>
    <%= f.text_field :street1, placeholder: Address.human_attribute_name(:street1_info) %>
    <%= f.text_field :street2 %>
    <%= f.text_field :street3, placeholder: Address.human_attribute_name(:street3_info) %>
    <%= f.text_field :zip, jui: :tiny %>
    <%= f.text_field :city %>
    <%= f.text_field :phone %>
    <dd><%= raw t '.number_format' %></dd>
    <%= f.text_field :fax %>
    <%= f.text_field :mobile %>
    <%= f.email_field :email %>
    <%= f.text_area :remarks %>
  </dl>
</div>
