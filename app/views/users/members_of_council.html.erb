<% title t("helpers.pages.members_of_council") %>

<% #if can? :create, User %>
<!--
<p class="horizontal-menu"><%= image_link_tag_helper "disk", phone_list_pdf_users_path %></p>
-->
<% #end %>


<%#= paginate @users if @users.present? %>
<table class='autolink'>
  <tr>
    <th><%= Role.human_attribute_name(:display_name) %></th>
    <th><%= Role.human_attribute_name(:email) %></th>
    <th><%= User.human_attribute_name(:fullname) %></th>
    <th><%= User.human_attribute_name(:email) %></th>
    <th></th>
  </tr>
  <%# @users.each do |user| %>
  <% @roles.each do |role| %>
    <tr>
      
      <td><%= dash(role.display_name) %></td>
      <td><%= dash(role.email) %></td>
      <td><%= dash(role.users.first.fullname) %></td>
      <td><%= raw dash(role.users.first.positions_email_adresses).gsub(/\n/,"<br />") %></td>
      <td>
        <%= show_link_to role.users.first if can?(:show, role.users.first) %>
      </td>
    </tr>
  <% end %>
</table>

<%#= paginate @users if @users.present? %>
