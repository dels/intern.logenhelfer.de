<%= form_for @event, builder: DefiniteFormBuilder do |f| %>
  <%= f.error_messages %>
  <dl>
    <%= f.text_field :title %>
    <%= f.date_select :date %>
    <dt><%= f.label :whole_day %></dt>
    <dd><%= f.check_box :whole_day %></dd>
    <%= f.time_select :time, { minute_step: 5 }, jui: :tiny %>
    <%= f.text_area :public_description %>
    <%= f.text_area :private_description %>
    <%= f.submit %>
  </dl>
<% end %>

<script type="text/javascript">
  $(function() {
    $('#event_whole_day').change(function() {
      $('.fields_for_event_time').toggle();
    })
  })
</script>
