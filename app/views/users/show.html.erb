<% title t("activerecord.models.user") %>

<p class="horizontal-menu">
  <%= edit_link_to @user if can?(:edit, @user) %>
  <%= destroy_link_to @user if can?(:destroy, @user) %>
  <%= show_link_to_all User if can?(:index, User) %>
</p>

<dl>
  <dt><%= t 'activerecord.attributes.user.email' %>:</dt>
  <dd><%= @user.email %></dd>
  <dt><%= t 'activerecord.attributes.user.encrypted_password' %>:</dt>
  <dd><%= @user.encrypted_password %></dd>
  <dt><%= t 'activerecord.attributes.user.reset_password_token' %>:</dt>
  <dd><%= @user.reset_password_token %></dd>
  <dt><%= t 'activerecord.attributes.user.reset_password_sent_at' %>:</dt>
  <dd><%= @user.reset_password_sent_at %></dd>
  <dt><%= t 'activerecord.attributes.user.remember_created_at' %>:</dt>
  <dd><%= @user.remember_created_at %></dd>
  <dt><%= t 'activerecord.attributes.user.sign_in_count' %>:</dt>
  <dd><%= @user.sign_in_count %></dd>
  <dt><%= t 'activerecord.attributes.user.current_sign_in_at' %>:</dt>
  <dd><%= @user.current_sign_in_at %></dd>
  <dt><%= t 'activerecord.attributes.user.last_sign_in_at' %>:</dt>
  <dd><%= @user.last_sign_in_at %></dd>
  <dt><%= t 'activerecord.attributes.user.current_sign_in_ip' %>:</dt>
  <dd><%= @user.current_sign_in_ip %></dd>
  <dt><%= t 'activerecord.attributes.user.last_sign_in_ip' %>:</dt>
  <dd><%= @user.last_sign_in_ip %></dd>

</dl>
