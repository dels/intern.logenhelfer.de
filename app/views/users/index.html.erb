<% title t("activerecord.models.user") %>

<% if can? :create, User %>
<p class="horizontal-menu"><%= link_to t("activerecord.actions.create_new", :model => t("activerecord.models.user")), new_user_path %></p>
<% end %>

<%= paginate @users if @users.present? %>

<table class='autolink'>
  <tr>
    <th><%= sortable :matriculation_number, User.human_attribute_name(:matriculation_number) %></th>
    <th><%= sortable :title, User.human_attribute_name(:title) %></th>
    <th><%= sortable :firstname,User.human_attribute_name(:firstname) %></th>
    <th><%= sortable :lastname,User.human_attribute_name(:lastname) %></th>
    <th><%= sortable :date_of_birth,User.human_attribute_name(:date_of_birth) %></th>
    <th><%= sortable :accpected_at,User.human_attribute_name(:accepted_at) %></th>
    <th></th>
  </tr>
  <% @users.each do |user| %>
    <tr>
      <td><%= user.matriculation_number %></td>
      <td><%= user.title_str %></td>
      <td><%= dash(user.firstname) %></td>
      <td><%= dash(user.lastname) %></td>
      <td><%= dash(user.date_of_birth ? l(user.date_of_birth) : nil) %></td>
      <td><%= dash(user.accepted_at ? l(user.accepted_at) : nil) %></td>
      <td>
        <%= show_link_to user if can?(:show, user) %>
        <%= edit_link_to user if can?(:edit, user) %>
        <%= destroy_link_to user if can?(:destroy, user) %>
      </td>
    </tr>
  <% end %>
</table>
