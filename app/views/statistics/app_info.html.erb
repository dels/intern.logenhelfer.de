
<h1>Application Information</h1>

<h3>Rails version:</h3>
<p><b><%= Rails.version%></b></p>

<h3>Rails Environment:</h3>
<p><b>
<%= Rails.env %></b></p>

<h3>Git Hash</h3>
<p><b><%= APP_VERSION[:hash] %></b></p>

<h3>Last Commit</h3>
<p><b><%= l(Date.parse(APP_VERSION[:last_commit_at])) %></b></p>

<h3>Deployed at:</h3>
<p><b><%= l(APP_VERSION[:deployed_at_full], format: :numbers_only) %></b></p>

<h3>Resque Jobs </h3>
<p><b><%= link_to "overview", resque_backend_statistics_url, target: :_blank %></b></p>


