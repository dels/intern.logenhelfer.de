<% title @user.fullname %>

<p class="horizontal-menu">
  <%= edit_link_to @user if can?(:edit, @user) %>
  <%= destroy_link_to @user if can?(:destroy, @user) %>
  <%= show_link_to_all User if can?(:index, User) %>
  <%= image_link_tag_helper 'vcard', user_path(@user, format: :vcf) %>
</p>

<dl>
  <dt><%= t 'activerecord.attributes.user.matriculation_number' %>:</dt>
  <dd><%= @user.matriculation_number %></dd>

  <dt><%= t 'activerecord.attributes.user.email' %>:</dt>
  <dd><%= @user.email %></dd>

  <dt><%= t 'activerecord.attributes.user.title' %>:</dt>
  <dd><%= dash(@user.title_str) %></dd>

  <dt><%= t 'activerecord.attributes.user.firstname' %>:</dt>
  <dd><%= @user.firstname %></dd>

  <dt><%= t 'activerecord.attributes.user.lastname' %>:</dt>
  <dd><%= @user.lastname %></dd>

  <dt><%= t 'activerecord.attributes.user.job_title' %>:</dt>
  <dd><%= dash(@user.job_title) %></dd>

  <dt><%= t 'activerecord.attributes.user.num_degree' %>:</dt>
  <dd><%= @user.rome_degree %></dd>

  <dt><%= t 'activerecord.attributes.user.accepted_at' %>:</dt>
  <dd><%= dash(@user.accepted_at ? l(@user.accepted_at) : nil) %></dd>

  <dt><%= t 'activerecord.attributes.user.date_of_birth' %>:</dt>
  <dd><%= dash(@user.date_of_birth ? l(@user.date_of_birth) : nil) %></dd>

  <dt><%= t 'activerecord.attributes.user.degrees' %>:</dt>
  <dd>
    <%
      roles = @user.user_roles.where(role_id: Role.degrees)
      if roles.count > 0
    %>
      <ul>
        <% roles.each do |role| %>
          <li><%= role %></li>
        <% end %>
      </ul>
    <% else %>
      <%= dash %>
    <% end %>
  </dd>

  <dt><%= t 'activerecord.attributes.user.positions' %>:</dt>
  <dd><ul>
    <% @user.roles.positions.each do |role| %>
      <li><%= role %></li>
    <% end %>
  </ul></dd>

  <% unless @user.addresses.empty? %>
    <h2><%= t 'activerecord.models.addresses' %></h2>
    <%= render 'addresses/address_fields', address: @user.business_address if @user.business_address %>
    <%= render 'addresses/address_fields', address: @user.private_address if @user.private_address %>
    <% @user.other_addresses.each do |addr| %>
      <%= render 'addresses/address_fields', address: addr %>
    <% end %>
  <% end %>

</dl>
