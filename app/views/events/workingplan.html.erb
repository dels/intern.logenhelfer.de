<%-
  title t('.workingplan.header',
    from: l(@from, format: @from.year == @to.year ? '%b.' : '%b. %Y'), # apr-may 2011 vs. dec 2011-jan 2012
    to: l(@to, format: '%b. %Y'))
-%>

<p class="top pdf icon avoid-bijoux"><%= raw t '.workingplan.pdf_export', url: calendar_export_url(format: :pdf) %></p>
<p class="top calendar icon avoid-bijoux"><%= raw t '.workingplan.ical_export', url: calendar_export_url(format: :ics) %></p>

<dl class="inverse-width">
  <%- @events.group_by(&:date).each do |date, events| -%>
    <dt><%= l date %></dt>
    <%- events.each do |e| -%>
      <dd>
        <strong><%= e.whole_day? ? 'ganztags' : l(e.time, format: '%H:%M Uhr') %></strong>:
        <%= e.title %>
      </dd>
      <dd><%= e.public_description %></dd>
    <%- end -%>
  <%- end -%>
</dl>