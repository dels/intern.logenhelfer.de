<%= form_for(resource, :as => resource_name, :url => session_path(resource_name)) do |f| %>
  <dl>
    <dt><%= f.label :email %></dt>
    <dd><%= f.email_field :email, class: jqueryui_input_classes %></dd>

    <dt><%= f.label :password %></dt>
    <dd><%= f.password_field :password, class: jqueryui_input_classes %></dd>

    <% if devise_mapping.rememberable? -%>
      <dt>&nbsp;</dt>
      <dd><%= f.check_box :remember_me %> <%= f.label :remember_me, t('devise.pages.sign_in.remember_me') %></dd>
    <% end -%>
    <dt>&nbsp;</dt>
    <dd><%= f.submit t('devise.pages.sign_in.header') %></dd>
  </dl>
<% end %>
