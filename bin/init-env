#!/usr/bin/env bash
# bin/init-env — scaffolds a new local .env.<name> file for bin/deploy-to.
# Auto-generates secrets (JWT_SECRET, DB password); prompts for the rest.
# Writes ONLY the local file — it never touches any remote host or runs any
# docker/ssh command. bin/deploy-to is what pushes/deploys it afterward.
set -euo pipefail
cd "$(dirname "$0")/.."

die() { echo "ERROR: $*" >&2; exit 1; }

FORCE=false
NAME=""
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    -*) die "unknown flag: $arg" ;;
    *) NAME="$arg" ;;
  esac
done
[[ -n "$NAME" ]] || die "Usage: bin/init-env <name> [--force]"
[[ "$NAME" =~ ^[a-z0-9-]+$ ]] || die "name must match ^[a-z0-9-]+\$, got '$NAME'"

ENV_FILE=".env.$NAME"
if [[ -f "$ENV_FILE" && "$FORCE" != true ]]; then
  die "$ENV_FILE already exists — pass --force to overwrite"
fi

command -v openssl >/dev/null 2>&1 || die "openssl not found in PATH"

prompt() {
  local var_name="$1" label="$2" default="${3:-}" reply
  # Plain stdin (not /dev/tty): unlike bin/deploy-to, this script isn't
  # nested inside another pipe-consuming context (e.g. an SSH heredoc), so
  # there's nothing to protect stdin from - and reading plain stdin is what
  # lets this be scripted/tested with piped input, not just run interactively.
  if [[ -n "$default" ]]; then
    read -r -p "$label [$default]: " reply
    reply="${reply:-$default}"
  else
    read -r -p "$label: " reply
    [[ -n "$reply" ]] || die "$label is required"
  fi
  printf -v "$var_name" '%s' "$reply"
}

echo "Scaffolding $ENV_FILE for environment '$NAME'..."
prompt DEPLOY_HOST     "Deploy host (SSH hostname)"
prompt DEPLOY_USER     "Deploy user (SSH login)"
prompt DEPLOY_PATH     "Deploy path (existing git checkout on the host)"
prompt DEPLOY_SSH_PORT "SSH port" "22"
prompt DB_HOST         "Database host" "127.0.0.1"
prompt DB_NAME         "Database name" "logenhelfer_$NAME"

DB_USER="logenhelfer_$NAME"
# openssl base64 output can contain '/', '+', '=' - valid in a URL password
# per RFC 3986 but need percent-encoding to survive unescaped inside a
# postgres:// URL. Stripping to alnum-only is simpler than encoding and
# can't break DB_URL parsing.
DB_PASSWORD=$(openssl rand -base64 24 | tr -dc 'A-Za-z0-9')
JWT_SECRET=$(openssl rand -hex 32)
MFA_ENCRYPTION_KEY=$(openssl rand -hex 32)
STATUS_ENDPOINT_TOKEN=$(openssl rand -hex 32)
DB_URL="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}"

cat > "$ENV_FILE" <<EOF
# Generated by bin/init-env on $(date -u +%Y-%m-%dT%H:%M:%SZ) for environment '$NAME'.
# This file is the source of truth - bin/deploy-to pushes it to the deploy
# host before every deploy. Never hand-edit the copy on the host.

# --- Deploy orchestration ---
DEPLOY_HOST=$DEPLOY_HOST
DEPLOY_USER=$DEPLOY_USER
DEPLOY_PATH=$DEPLOY_PATH
DEPLOY_SSH_PORT=$DEPLOY_SSH_PORT
# ERROR_PAGES_PATH=/srv/logenhelfer-errors/$NAME  # optional, see .env.example

# --- Runtime secrets / config ---
DB_URL=$DB_URL
JWT_SECRET=$JWT_SECRET
MFA_ENCRYPTION_KEY=$MFA_ENCRYPTION_KEY
STATUS_ENDPOINT_TOKEN=$STATUS_ENDPOINT_TOKEN
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_STATUS_MAX=60
RATE_LIMIT_STATUS_WINDOW_MS=60000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=60000
MAIL_TRANSPORT=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
VITE_IDLE_TIMEOUT_MINUTES=30
# logenhelfer- prefix avoids colliding with sibling projects' container
# names on a shared host (see CLAUDE.md's container-naming note).
API_CONTAINER_NAME=logenhelfer-api-$NAME
APP_CONTAINER_NAME=logenhelfer-app-$NAME
EDGE_CONTAINER_NAME=logenhelfer-edge-$NAME
# APP_PORT=
# APP_LISTEN_IP=
EOF

chmod 600 "$ENV_FILE"
echo "Wrote $ENV_FILE (mode 600)."
echo
echo "Before the first deploy, run this on $DB_HOST as a Postgres superuser"
echo "(role/database don't exist yet — bin/deploy-to's migration step assumes they do):"
echo
cat <<SQL
CREATE ROLE $DB_USER LOGIN PASSWORD '$DB_PASSWORD';
CREATE DATABASE $DB_NAME OWNER $DB_USER;
SQL
echo
echo "Then: bin/deploy-to $NAME"
echo "Add the new env to /etc/rc.local"
