    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "ical-generator": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
