
<% title "Kontakte synchronisieren" %>

<%= render 'google_header' %>

<% if current_google_user %>
<% if @res.count > 0 %>
  <%= paginate @res if @res.present? %>
  <table class='autolink'>
    <tr>
      <th><%= sortable :lastname, User.human_attribute_name(:lastname) %></th>
      <th><%= sortable :firstname, User.human_attribute_name(:firstname) %></th>
      <th>Google Status</th>
      <th></th>
    </tr>
    <% @res.each do |user| %>
      <tr>
        <td><%= dash(user.lastname) %></td>
        <td><%= dash(user.firstname) %></td>
        <td>
          <% if user.google_edit_url %>
          <%= link_to t('contact_sync.update'), update_google_contact_users_path(user, :edit_url => user.google_edit_url, :self_url => user.google_self_url) %>
          <% else %>
          <%= link_to t('contact_sync.create'), create_google_contact_users_path(user) %>
          <% end %>
        </td>
        <td>
          <%= show_link_to user if can?(:show, user) %>
          <%= image_link_tag_helper 'vcard',      user_path(user, format: :vcf)            if can?(:show, user) %>
        </td>
      </tr>
    <% end %>
  </table>
  <%= paginate @res if @res.present? %>
<%- else -%>
  <p>Keine Mitglieder gefunden.</p>
<%- end -%>

<% else %>
  <b>Achtung!</b>
<p>
  Diese neue Funktion befindet sich noch in der <b>Test-Phase</b>. Sie ist noch nicht ausreichend getestet und könnte zu Datenverlust in Deinem Google Addressbuch führen.
</p>
<p>
  Falls Du dieses neue Feature dennoch ausprobieren möchtest, dann fahre gerne fort und melde Dich mit Deinem Google Konto an. 
</p>
<%= link_to t('contact_sync.google.sign_in'), "/auth/google_oauth2", id: "sign_in" %>
<% end %>


