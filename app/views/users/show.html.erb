<% title @user.fullname %>

<p class="horizontal-menu">
  <%= edit_link_to @user if can?(:edit, @user) %>
  <%= destroy_link_to @user if can?(:destroy, @user) %>
  <%= show_link_to_all User if can?(:index, User) %>
  <%= image_link_tag_helper 'vcard', user_path(@user, format: :vcf) %>
</p>

<dl>
  <dt><%= User.human_attribute_name :matriculation_number %>:</dt>
  <dd><%= @user.matriculation_number %></dd>

  <dt><%= User.human_attribute_name :email %>:</dt>
  <dd><%= @user.email %></dd>

  <dt><%= User.human_attribute_name :academic_title_id %>:</dt>
  <dd><%= dash(@user.academic_title) %></dd>

  <dt><%= User.human_attribute_name :firstname %>:</dt>
  <dd><%= @user.firstname %></dd>

  <dt><%= User.human_attribute_name :lastname %>:</dt>
  <dd><%= @user.lastname %></dd>

  <dt><%= User.human_attribute_name :job_title %>:</dt>
  <dd><%= dash(@user.job_title) %></dd>

  <dt><%= User.human_attribute_name :num_degree %>:</dt>
  <dd><%= @user.rome_degree %></dd>

  <dt><%= User.human_attribute_name :accepted_at %>:</dt>
  <dd><%= dash(@user.accepted_at ? l(@user.accepted_at) : nil) %></dd>

  <dt><%= User.human_attribute_name :mother_lodge %>:</dt>
  <dd><%= dash(@user.mother_lodge) %></dd>

  <dt><%= User.human_attribute_name :date_of_birth %>:</dt>
  <dd><%= dash(@user.date_of_birth ? l(@user.date_of_birth) : nil) %></dd>

  <% 
      roles = @user.user_roles.where(role_id: Role.degrees) 
      if roles.count > 0 
    %>

  <dt><%= User.human_attribute_name :degrees %>:</dt>
  <dd>
      <ul>
        <% roles.each do |role| %>
          <li><%= role %></li>
        <% end %>
      </ul>
    <% else %>
      <%= dash %>
    <% end %>
  </dd>

  <%
    positions = @user.roles.positions
    if positions.count > 0 
    %>
  <dt><%= User.human_attribute_name :positions %>:</dt>
  <dd><ul>
    <% @user.roles.positions.sort_by(&:display_name).each do |role| %>
      <li><%= role %></li>
    <% end %>
  </ul></dd>
  <% end %>
  
  <% if can?(:edit, @user) %>
  <dt><%= User.human_attribute_name :administrational_rights %>:</dt>
  <dd><ul>
    <% @user.roles.administrational_roles.sort_by(&:display_name).each do |role| %>
      <li><%= role %></li>
    <% end %>
  </ul></dd>
  <% end %>

  <% unless @user.addresses.empty? %>
    <h2><%= t 'activerecord.models.addresses' %></h2>
    <%= render 'addresses/address_fields', address: @user.business_address if @user.business_address %>
    <%= render 'addresses/address_fields', address: @user.private_address if @user.private_address %>
    <% @user.other_addresses.each do |addr| %>
      <%= render 'addresses/address_fields', address: addr %>
    <% end %>
  <% end %>

</dl>
