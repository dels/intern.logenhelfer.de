<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} - #{AppConfig[:lodge]}" : AppConfig[:lodge] %></title>
    <%= render 'layouts/jquery_format_locales' %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application" %>
    <%= favicon_link_tag %>
    <%= csrf_meta_tag %>
    <%= yield(:head) %>
  </head>
  <body>
  <% if Rails.env.development? or Rails.env.demo? %>
    <div id="banner">
      <div id="banner-content">
        Achtung: Diese Instanz dient nur zur Veranschaulichung. Alle Daten werden in regelmäßigen Abständen gelöscht.
      </div>
    </div>
    <% end %>
    <% if current_user.app_responsible? && AttachedFile::memory_exceeded? %>
    <div id="mem_banner">
      <div id="mem_banner-content">
        Achtung! Kein Speicher mehr vorhanden: <%= number_to_human_size AttachedFile::memory_used %>/<%= number_to_human_size AppConfig[:max_db_mem_size] %>. Es können keine Dateien mehr hochgeladen werden.
      </div>
    </div>
    <% end %>

    <nav id="left">
      <%= render 'layouts/menu' %>
    </nav>

    <section>
      <nav id="top-menu">
        <%= render 'layouts/top_menu' %>
      </nav>
      <%- if flash.any? -%>
        <% flash.each do |name, msg| %>
          <%= content_tag :header, content_tag(:span, msg), :id => "flash-#{name}" %>
        <% end %>
      <%- end -%>

      <%= content_tag :h1, yield(:title), :class => 'title' if show_title? %>
      <%= yield %>
    </section>

    <footer>
    <% if Rails.env.development? || Rails.env.test? %>
      In <%= Rails.env %> mode. Version <%= APP_VERSION_STRING %>, zuletzt aktualisiert am <%= l(Date.parse(APP_VERSION[:last_commit_at]), format: :long) %>
    <% else %>
      Version <%= APP_VERSION_STRING %>, zuletzt aktualisiert am <%= l(Date.parse(APP_VERSION[:last_commit_at]), format: :date_only) %>
    <% end %>
    </footer>

    <% if current_user && Rails.env.development? %>
      <footer style="text-align: left; font-size: 1em; line-height: 1;">
        <h4>Debugging (dev-only)</h4>
        <h5>current_user:</h5> <pre><%= current_user.to_yaml %></pre>
        <h5>params:</h5> <%= debug params %>
        <h5>URIs</h5> <%= debug 'fullpath' => request.fullpath, 'path' => request.path, 'domain' => request.url %>
      </footer>
    <% end %>

    <div id="throbble-container">
      <p id="throbble-notice">
        <%= image_tag 'throbbler.gif' %>
        <%= t 'shared.please_be_patient' %>
      </p>
    </div>
  </body>
</html>
