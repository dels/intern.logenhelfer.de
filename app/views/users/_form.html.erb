
<%= form_for @user, builder: DefiniteFormBuilder do |f| %>
  <%= f.error_messages %>
  <dl>
    <%= f.number_field :matriculation_number,     readonly: limited_user_editing? %>
    <%= f.text_field :email,                      readonly: limited_user_editing? %>

    <%#= f.password_field :password, autocomplete: :off %>
    <%#= f.password_field :password_confirmation, autocomplete: :off %>

    <% if limited_user_editing? %>
    <%= f.text_field :academic_title,                   readonly: true %>
    <% else %>
    <%= f.collection_select :academic_title_id, AcademicTitle.undeleted.all, :id, :short, include_blank: :true %>
    <% end %>
    <%= f.text_field :firstname,                  readonly: limited_user_editing? %>
    <%= f.text_field :lastname,                   readonly: limited_user_editing? %>
    <%= f.text_field :job_title %>
    <%= f.date_select :date_of_birth,             readonly: limited_user_editing? %>
    <%= f.date_select :accepted_at,               readonly: limited_user_editing? %>
    <%= f.text_field :mother_lodge,               readonly: limited_user_editing? %>

    <%= f.date_select :entered_apprentice_since,  readonly: limited_user_editing? %>
    <%= f.date_select :fellow_craft_since,        readonly: limited_user_editing? %>
    <%= f.date_select :master_mason_since,        readonly: limited_user_editing? %>

    <% if current_user.admin? || current_user.secretary? %>
    <%= f.collection_select :roles, Role.position_ids, :id, :to_s, { selected: @user.role_ids }, style: 'width:300px', multiple: true, name: 'user[role_ids][]' %>
    <%= f.collection_select :administrational_roles, Role.administrational_role_ids, :id, :to_s, { selected: @user.role_ids }, style: 'width:300px', multiple: true, name: 'user[role_ids][]' %>
    <% else %>
      <ul>
        <% (@user.roles & Role.degrees).each do |role| %>
          <li><%= role %></li>
        <% end %>
      </ul>
      <% end %>
    <%= f.submit %>
  </dl>

  <h2><%= t 'user_fields.address_attributes' %></h2>
  <p><%= link_to_add_fields Address.human_attribute_name(:add_fields), f, :addresses %></p>
  <dl>
    <%= f.fields_for :addresses do |builder| %>
      <%= render 'addresses/form_fields', f: builder %>
    <% end %>
    <%= f.submit %>
  </dl>
<% end %>
