
<%= form_for @seeker, builder: DefiniteFormBuilder do |f| %>
  <%= f.error_messages %>
  <dl>
    <dt><%= t('activerecord.attributes.seeker.invite') %></dt>
    <dd>
      <%= f.check_box :invite %>
    </dd>
    <%= f.text_field :firstname %>
    <%= f.text_field :lastname %>
    <%= f.text_field :source %>
    <%= f.select :preferred_way_of_contact, Seeker::WAY_OF_CONTACT.to_a.map{|k,v| [I18n.t("activerecord.seeker.preferred_way_of_contact.#{k}"), v]}, { include_blank: true }, data: { placeholder: I18n.t('helpers.select.prompt') }, class: "type_of_address" %>
    <%= f.select :status, Seeker::STATUS.to_a.map{|k,v| [I18n.t("activerecord.seeker.status.#{k}"), v]}, { include_blank: true }, data: { placeholder: I18n.t('helpers.select.prompt') }, class: "type_of_address" %>

    <%= f.submit %>
  </dl>

  <h2><%= t 'user_fields.address_attributes' %></h2>
  <dl>
    <%= f.fields_for :address do |builder| %>
      <%= render 'addresses/form_fields', :f => builder %>
    <% end %>
    <%= f.submit %>
  </dl>

<% end %>
