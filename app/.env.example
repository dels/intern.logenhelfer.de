# Copy to app/.env (gitignored - the root .gitignore's bare ".env" pattern
# matches at any depth, including app/.env) to override locally. Vite only
# exposes variables prefixed VITE_ to client code via import.meta.env (see
# https://vite.dev/guide/env-and-mode.html) - this file is unrelated to the
# repo-root .env/.env.example the API and deploy scripts (bin/deploy-to) use.

# Minutes of no click/keydown activity before the SPA auto-logs the user out
# (see app/src/auth/useIdleTimeout.ts). Defaults to 30 if unset.
VITE_IDLE_TIMEOUT_MINUTES=30
