<%= form_for @user, builder: DefiniteFormBuilder do |f| %>
  <%= f.error_messages %>
  <dl>
    <%= f.text_field :email %>
    <%= f.text_field :firstname %>

    <%= f.text_field :lastname %>
    <%= f.date_select :date_of_birth %>
    <%= f.date_select :included_at %>
    <%= f.date_select :accepted_at %>

    <%= f.submit %>
  </dl>
<% end %>
