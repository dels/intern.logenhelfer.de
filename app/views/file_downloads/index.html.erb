<% title t("activerecord.models.file_download") %>

<%= paginate @file_downloads if @file_downloads.present? %>

<table>
  <tr>
    <th><%= t 'activerecord.attributes.file_download.attached_file_id' %></th>
    <th><%= t 'activerecord.attributes.file_download.user_id' %></th>
    <th><%= t 'activerecord.attributes.file_download.remote_ip' %></th>
    <th><%= t 'activerecord.attributes.file_download.created_at' %></th>
    <th></th>
  </tr>
  <% @file_downloads.each do |file_download| %>
    <tr>
      <td><%= file_download.filename %></td>
      <td><%= file_download.user.fullname %></td>
      <td><%= file_download.remote_ip %></td>
      <td><%= l file_download.created_at %></td>
      <td>
        <%= destroy_link_to file_download if can?(:destroy, file_download) %>
      </td>
    </tr>
  <% end %>
</table>

<%= paginate @file_downloads if @file_downloads.present? %>
