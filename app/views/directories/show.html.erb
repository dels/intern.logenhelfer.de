<% title t("activerecord.models.directory") %>

<p class="horizontal-menu">
  <%= edit_link_to @directory if can?(:edit, @directory) %>
  <%= destroy_link_to @directory if can?(:destroy, @directory) %>
  <%= show_link_to_all Directory if can?(:index, Directory) %>
</p>

<dl>
  <dt><%= t 'activerecord.attributes.directory.name' %>:</dt>
  <dd><%= @directory.name %></dd>
  <dt><%= t 'activerecord.attributes.directory.description' %>:</dt>
  <dd><%= @directory.description %></dd>
  <dt><%= t 'activerecord.attributes.directory.category_id' %>:</dt>
  <dd><%= @directory.category_id %></dd>

</dl>
