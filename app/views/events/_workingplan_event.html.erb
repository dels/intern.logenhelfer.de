<div class="event small">
  <div class="date">
    <span class="month"><%= l(date, format: '%b') %></span>
    <span class="day"><%= l date, format: '%d' %></span>
    <span class="dow"><%= l(date, format: '%a').upcase %></span>
    <span class="year"><%= l date, format: '%Y' %></span>
  </div>

  <%- events.each do |event| -%>
  <div id="event_list_item">
    <h3>
      <%- if event.whole_day? -%>
        <span class="time">ganztags:</span>
      <%- else -%>
        <span class="time"><%= l event.time, format: :time_only %> Uhr:</span>
      <%- end -%>
      <%= event.title %>
    </h3>
    <%- unless event.birthday? -%>
      <p id="event_list_item_location" class="map icon"><%= dash event.location %></p>
      <div id="event_list_item_public_description"  class="public top icon">
        <%= simple_format dash(event.public_description) %>
    </div>
  </div>
  <%- end -%>
<%- end -%>
</div>
