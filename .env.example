# SMTP_USER=
# SMTP_PASSWORD=
# REDIS_PROTOCOL=rediss  # optional, see the generic Redis section above
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=6379
# DEPLOY_NAME=
# VITE_IDLE_TIMEOUT_MINUTES=30
# ADMIN_USER=  # optional, see .env.next above
# ADMIN_PASSWORD=
# API_CONTAINER_NAME=logenhelfer-api-prod
# APP_CONTAINER_NAME=logenhelfer-app-prod
# EDGE_CONTAINER_NAME=logenhelfer-edge-prod
# APP_PORT=
# APP_LISTEN_IP=

