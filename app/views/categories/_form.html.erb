<%= form_for @category, builder: DefiniteFormBuilder do |f| %>
  <%= f.error_messages %>
  <dl>
    <%= f.text_field :name %>
    <%= f.text_area :description %>
    
    <%= f.collection_select :roles, Role.all, :id, :to_s, { :selected => @category.role_ids }, { :style => 'width:300px', :multiple => true, :name => 'category[role_ids][]' } %>

    <%= f.submit %>
  </dl>
<% end %>
