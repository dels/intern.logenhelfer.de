<% title t("activerecord.models.users") %>

<% if can? :create, User %>
<p class="horizontal-menu">
  <%= link_to t("activerecord.actions.create_new", model: t("activerecord.models.user")), new_user_path %>
</p>
<% end %>

<%= paginate @users if @users.present? %>

<table class='autolink'>
  <tr>
    <th><%= sortable :matriculation_number, User.human_attribute_name(:matriculation_number) %></th>
    <th><%= sortable :lastname, User.human_attribute_name(:lastname) %></th>
    <th><%= sortable :firstname, User.human_attribute_name(:firstname) %></th>
    <th><%= User.human_attribute_name(:address) %></th>
    <th><%= User.human_attribute_name(:phone) %></th>
    <th><%= User.human_attribute_name(:mobile) %></th>
    <th><%= sortable :date_of_birth, User.human_attribute_name(:date_of_birth) %></th>
    <th></th>
  </tr>
  <% @users.each do |user| %>
    <tr>
      <td><%= user.matriculation_number %></td>
      <td><%= dash(user.lastname) %></td>
      <td><%= dash(user.firstname) %></td>
      <td><%= dash(user.private_address.try :to_s) %></td>
      <td><%= dash(user.private_address.try :phone) %></td>
      <td><%= dash(user.private_address.try :mobile) %></td>
      <td><%= dash(user.date_of_birth ? l(user.date_of_birth) : nil) %></td>
      <td>
        <%= show_link_to user if can?(:show, user) %>
        <%= edit_link_to user if can?(:edit, user) %>
        <%= destroy_link_to user if can?(:destroy, user) %>
        <%= image_link_tag_helper 'vcard',      user_path(user, format: :vcf)            if can?(:show, user) %>
        <%= image_link_tag_helper 'substitute', substitute_user_path(user), method: :put if can?(:substitute, user) %>
      </td>
    </tr>
  <% end %>
</table>

<%= paginate @users if @users.present? %>
