<%- title t('.header.configuration') -%>

<p><%= raw t('.intro', env: Rails.env) %></p>

<h2><%= t '.header.general_configuration' %></h2>

<%= form_tag app_config_path, method: :put do %>
  <table class="wide" id="app-config">


    <!-- working plan footer content -->
    <tr>
      <th rowspan="2"><%= t '.options.workingplan_footer.name' %></th>
      <%- if t('.options.workingplan_footer').key?(:description) -%>
        <td colspan="2"><%= t '.options.workingplan_footer.description' %></td>
      <%- else -%>
        <td colspan="2"></td>
      <%- end -%>
      <td><tt>:workingplan_footer</tt></td>
    </tr>
    <tr>
      <td colspan="3"><%= text_area_tag 'app_config[workingplan_footer]', AppConfig[:workingplan_footer], class: jqueryui_input_classes, style: 'width:99%;height:14em' %></td>
    </tr>

    <!-- public working plan is visible without authentification -->
    <tr>
      <th><%= t '.options.public_wp_available_to_anon_users.name' %></th>
      <td>
        <label><%= radio_button_tag 'app_config[public_wp_available_to_anon_users]', '1', AppConfig[:public_wp_available_to_anon_users] %> ja</label>
        <label><%= radio_button_tag 'app_config[public_wp_available_to_anon_users]', '0', "0".eql?(AppConfig[:public_wp_available_to_anon_users]) %> nein</label>
      </td>
      <%- if t('.options.public_wp_available_to_anon_users').key?(:description) -%>
        <td><%= t '.options.public_wp_available_to_anon_users.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:public_wp_available_to_anon_users</tt></td>
    </tr>

    <!-- current instance acts as archive -->
    <tr>
      <th><%= t '.options.archive.name' %></th>
      <td>
        <label><%= radio_button_tag 'app_config[archive]', '1', AppConfig[:archive] %> ja</label>
        <label><%= radio_button_tag 'app_config[archive]', '0', !AppConfig[:archive] %> nein</label>
      </td>
      <%- if t('.options.archive').key?(:description) -%>
        <td><%= t '.options.archive.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:archive</tt></td>
    </tr>

    <!-- default domain name for calendar and contact export -->
    <tr>
      <th><%= t '.options.domain.name' %></th>
      <td><%= text_field_tag 'app_config[domain]', AppConfig[:domain], class: jqueryui_input_classes %></td>
      <%- if t('.options.domain').key?(:description) -%>
        <td><%= t '.options.domain.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:domain</tt></td>
    </tr>

    <!-- name of the organisation of the current instance -->
    <tr>
      <th><%= t '.options.organisation.name' %></th>
      <td><%= text_field_tag 'app_config[organisation]', AppConfig[:organisation], class: jqueryui_input_classes %></td>
      <%- if t('.options.organisation').key?(:description) -%>
        <td><%= t '.options.organisation.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:organisation</tt></td>
    </tr>

    <!-- name of the lodge of the current instance -->
    <tr>
      <th><%= t '.options.lodge.name' %></th>
      <td><%= text_field_tag 'app_config[lodge]', AppConfig[:lodge], class: jqueryui_input_classes %></td>
      <%- if t('.options.lodge').key?(:description) -%>
        <td><%= t '.options.lodge.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:lodge</tt></td>
    </tr>
    <!-- SHORT name of the lodge of the current instance -->
    <tr>
      <th><%= t '.options.lodge_short.name' %></th>
      <td><%= text_field_tag 'app_config[lodge_short]', AppConfig[:lodge_short], class: jqueryui_input_classes %></td>
      <%- if t('.options.lodge_short').key?(:description) -%>
        <td><%= t '.options.lodge_short.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:lodge_short</tt></td>
    </tr>

    <!-- show admins? -->
    <tr>
      <th><%= t '.options.show_admins.name' %></th>
      <td>
        <label><%= radio_button_tag 'app_config[show_admins]', '1', AppConfig[:show_admins] %> ja<label>
        <label><%= radio_button_tag 'app_config[show_admins]', '0', !AppConfig[:show_admins] %> nein</label>
      </td>
      <%- if t('.options.show_admins').key?(:description) -%>
        <td><%= t '.options.show_admins.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:show_admins</tt></td>
    </tr>
    <tr>
      <th><%= t '.options.default_workingplan_timespan.name' %></th>
      <td><%= text_field_tag 'app_config[default_workingplan_timespan]', AppConfig[:default_workingplan_timespan], class: jqueryui_input_classes %></td>
      <%- if t('.options.default_workingplan_timespan').key?(:description) -%>
        <td><%= t '.options.default_workingplan_timespan.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:default_workingplan_timespan</tt></td>
    </tr>

    <!-- default event location -->
    <tr>
      <th><%= t '.options.default_event_location.name' %></th>
      <td><%= text_field_tag 'app_config[default_event_location]', AppConfig[:default_event_location], class: jqueryui_input_classes %></td>
      <%- if t('.options.default_event_location').key?(:description) -%>
        <td><%= t '.options.default_event_location.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:default_event_location</tt></td>
    </tr>

    <!-- default notification e-mail address -->
    <tr>
      <th><%= t '.options.user_change_notification_email.name' %></th>
      <td><%= text_field_tag 'app_config[user_change_notification_email]', AppConfig[:user_change_notification_email], class: jqueryui_input_classes %></td>
      <%- if t('.options.user_change_notification_email').key?(:description) -%>
        <td><%= t '.options.user_change_notification_email.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:user_change_notification_email</tt></td>
    </tr>

    <!-- default from e-mail address -->
    <tr>
      <th><%= t '.options.default_from_email.name' %></th>
      <td><%= text_field_tag 'app_config[default_from_email]', AppConfig[:default_from_email], class: jqueryui_input_classes %></td>
      <%- if t('.options.default_from_email').key?(:description) -%>
        <td><%= t '.options.default_from_email.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:default_from_email</tt></td>
    </tr>

    <!-- technical contact e-mail address -->
    <tr>
      <th><%= t '.options.technical_contact_email.name' %></th>
      <td><%= text_field_tag 'app_config[technical_contact_email]', AppConfig[:technical_contact_email], class: jqueryui_input_classes %></td>
      <%- if t('.options.technical_contact_email').key?(:description) -%>
        <td><%= t '.options.technical_contact_email.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:technical_contact_email</tt></td>
    </tr>

    <!-- mvst e-mail address -->
    <tr>
      <th><%= t '.options.mvst_email.name' %></th>
      <td><%= text_field_tag 'app_config[mvst_email]', AppConfig[:mvst_email], class: jqueryui_input_classes %></td>
      <%- if t('.options.mvst_email').key?(:description) -%>
        <td><%= t '.options.mvst_email.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:mvst_email</tt></td>
    </tr>

    <!-- zip/location -->
    <tr>
      <th><%= t '.options.zip.name' %>/<%= t '.options.location.name' %></th>
      <td>
        <%= text_field_tag 'app_config[zip]', AppConfig[:zip], class: jqueryui_small_input_classes %>
        <%= text_field_tag 'app_config[location]', AppConfig[:location], class: jqueryui_medium_small_input_classes %>
      </td>
      <%- if t('.options.location').key?(:description) -%>
        <td><%= t '.options.location.description' %></td>
      <%- else -%>
        <td></td>
      <%- end -%>
      <td><tt>:zip</tt>, <tt>:location</tt></td>
    </tr>

    <!-- impressum text -->
    <tr>
      <th rowspan="2"><%= t '.options.impressum.name' %></th>
      <%- if t('.options.impressum').key?(:description) -%>
        <td colspan="2"><%= t '.options.impressum.description' %></td>
      <%- else -%>
        <td colspan="2"></td>
      <%- end -%>
      <td><tt>:impressum</tt></td>
    </tr>
    <tr>
      <td colspan="3"><%= text_area_tag 'app_config[impressum]', AppConfig[:impressum], class: jqueryui_input_classes, style: 'width:99%;height:14em' %></td>
    </tr>


    <!-- robots.txt content -->
    <tr>
      <th rowspan="2"><%= t '.options.robots_txt.name' %></th>
      <%- if t('.options.robots_txt').key?(:description) -%>
        <td colspan="2"><%= t '.options.robots_txt.description' %></td>
      <%- else -%>
        <td colspan="2"></td>
      <%- end -%>
      <td><tt>:robots_txt</tt></td>
    </tr>
    <tr>
      <td colspan="3"><%= text_area_tag 'app_config[robots_txt]', AppConfig[:robots_txt], class: jqueryui_input_classes, style: 'width:99%;height:14em' %></td>
    </tr>

  </table>
  <dl class="buttons">
    <dt>&nbsp;</dt>
    <dd><%= submit_tag t('helpers.button.update', model: t('activerecord.models.app_config')), name: nil %></dd>
  </dl>
<%- end -%>


<h2><%= t '.header.academic_titles' %></h2>


<dl>
  <dt><%= t '.header.academic_titles' %></dt>
  <dd>
    <table class="narrow">
      <%- @academic_titles.each do |at| -%>
        <tr>
          <td class="wide-25em"><%= best_in_place at, :short %></td>
          <td><%= at.users.count %> <%= t 'activerecord.models.users' %></td>
          <td><%= destroy_link_to at if at.users.count.zero? %></td>
        </tr>
      <%- end -%>
    </table>
  </dd>

  <dt><%= t 'activerecord.attributes.academic_title.add_fields' %></dt>
  <dd>
    <%= form_for AcademicTitle.new do |f| -%>
      <%= f.text_field :short %>
      <%= f.submit %>
    <%- end -%>
  </dd>
</dl>
