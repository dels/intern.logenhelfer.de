<% title t("activerecord.models.user") %>

<p class="horizontal-menu">
  <%= edit_link_to @user if can?(:edit, @user) %>
  <%= destroy_link_to @user if can?(:destroy, @user) %>
  <%= show_link_to_all User if can?(:index, User) %>
</p>

<dl>
  <dt><%= t 'activerecord.attributes.user.email' %>:</dt>
  <dd><%= @user.email %></dd>
  <dt><%= t 'activerecord.attributes.user.firstname' %>:</dt>
  <dd><%= @user.firstname %></dd>
  <dt><%= t 'activerecord.attributes.user.lastname' %>:</dt>
  <dd><%= @user.lastname %></dd>
  <dt><%= t 'activerecord.attributes.user.num_degree' %>:</dt>
  <dd><%= @user.rome_degree %></dd>
  <dt><%= t 'activerecord.attributes.user.included_at' %>:</dt>
  <dd><%= dash(@user.included_at) %></dd>
  <dt><%= t 'activerecord.attributes.user.accepted_at' %>:</dt>
  <dd><%= dash(@user.accepted_at) %></dd>
  <dt><%= t 'activerecord.attributes.user.date_of_birth' %>:</dt>
  <dd><%= dash(@user.date_of_birth) %></dd>
  

</dl>
