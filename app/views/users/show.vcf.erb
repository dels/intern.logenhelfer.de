BEGIN:VCARD
VERSION:3.0
N:<%= @user.lastname %>; <%= @user.firstname %>
FN:<%= @user.fullname %>
ORG:<%= APP_CONFIG[:organisation] %>
URL:http://<%= APP_CONFIG[:domain] %>/
EMAIL;TYPE=INTERNET:<%= @user.email %>
<% @user.addresses.each do |addr| %>
<% if addr.phone %>
TEL;TYPE=voice,<%= addr.purpose %>:<%= addr.phone %>
<% end %>
<% if addr.mobile %>
TEL;TYPE=voice,cell,<%= addr.purpose %>:<%= addr.mobile %>
<% end %>
<% if addr.fax %>
TEL;TYPE=fax,<%= addr.purpose %>:<%= addr.fax %>
<% end %>
ADR;TYPE=postal,parcel,<%= addr.purpose %>:;;<%= addr.street %>;<%= addr.city %>;;<%= addr.zip %>;
<% if addr.remarks %>
NOTE:<%= addr.remarks %>
<% end %>
<% end %>
END:VCARD