<%= form_for @attached_file.path_array, :html => { :multipart => true } , builder: DefiniteFormBuilder do |f| %>
  <%= f.error_messages %>
  <dl>
    <% if f.object.new_record? %>
      <%= f.file_field :file %>
    <% end %>
    <%= render 'roles/role_chooser', :f => f %>

    <%= f.submit %>
  </dl>
<% end %>
