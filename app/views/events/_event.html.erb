
<div class="event">
  <%- unless event.try(:birthday?) -%>
    <div class="date">
      <span class="month"><%= l(event.date, format: '%b').upcase %></span>
      <span class="day"><%= l event.date, format: '%d' %></span>
      <span class="dow"><%= l(event.date, format: '%a').upcase %></span>
      <span class="year"><%= l event.date, format: '%Y' %></span>
    </div>
  <%- end -%>
  
  <h3>
    <%- if event.try(:whole_day?) -%>
      <span class="time">ganztags:</span>
    <%- else -%>
      <span class="time"><%= l event.time, format: :time_only %> Uhr:</span>
    <%- end -%>
    <%= event.title %>
  </h3>
  
  <%- unless event.try(:birthday?) -%>
  <p class="map icon"id='<%= "#{event.class.to_s.underscore}_location"%>'><%= dash event.location %></p>
  <%- if event.try(:private_description) -%>
  <!-- fields for internal event -->
  <p class="icon label"><%= Event.human_attribute_name :private_description %>:</p>
  <%= simple_format dash(event.private_description), class: 'private_description', id: "#{event.class.to_s.underscore}_private_description" %>
  <%- end -%>  
  <%- if event.try(:public_description) -%>
  <p class="icon label"><%= Event.human_attribute_name :public_description %>:</p>
  <%= simple_format dash(event.public_description), class: 'public_description', id: "#{event.class.to_s.underscore}_public_description" %>
  <%- end -%>

  
  <%- if event.try(:description) -%>
  <!-- fields for external event -->
  <p class="public icon label"><%= ExternalEvent.human_attribute_name :description %>:</p>
  <%= simple_format dash(event.description), class: 'description', id: "#{event.class.to_s.underscore}_description" %>
  <%- end -%>

  
<!-- fields for external event subscription -->
<%- if event.respond_to?(:subscription) -%>
<!-- fields for external event subscription -->
<%-
  # user has no subscption to this event
  -%>
<%- unless event.subscription(current_user) -%>
  <p id='<%= "#{event.class.to_s.underscore}_subscribe_to_work" %>' class="description newspaper icon">
    <%= link_to t('text.external_event_subscription.subscribe_to_work'), external_event_add_me_path(event, :festive_board => false)%>
  </p>
  <p id='<%= "#{event.class.to_s.underscore}_subscribe_to_work_with_festive_board" %>' class="description , newspaper_add icon">
    <%= link_to t('text.external_event_subscription.subscribe_to_work_and_festive_board'), external_event_add_me_path(event, :festive_board => true)%>
  </p>
  <%- end -%>
  <%-
    # user has an unconfirmed subscription
    -%>  
  <%- if event.subscription(current_user) && false == event.subscription_confirmed?(current_user) -%>  
  <p id='<%= "#{event.class.to_s.underscore}_awaiting_subscribed" %>' class="description spinner icon">
    <%= event.try(:subscription, current_user).try(:festive_board) ? t('text.external_event_subscription.awaiting_secretary_to_confirm_subscription_including_festive_board') : t('text.external_event_subscription.awaiting_secretary_to_confirm_subscription') %>
  </p>
  <%- elsif (event.subscription(current_user) && event.subscription_confirmed?(current_user)) -%>
  <p id='<%= "#{event.class.to_s.underscore}_subscribed" %>' class="description success icon">
    <%= event.subscription(current_user).try(:festive_board) ? t('text.external_event_subscription.subscribed_to_work_with_festive_board') : t('text.external_event_subscription.subscribed_to_work') %>
  </p>
  <%- end -%>
  <%- end -%>
   
    
    <%- if event.respond_to?(:to_ical) -%>
  <p class="action icon label"><%= t '.actions' %></p>
  <p class="public_description calendar icon"><%=  raw t '.ical_export', url: event_path(event, format: :ics) %></p>
  <%- end -%>
  
  <%- if can?(:edit, event) -%>
  <p class="edit_event, description"><%= edit_link_to(event, true) %></p>
  <%- end -%>
  <%- if can?(:edit, event) -%>
  <p class="delete_event, description"><%= destroy_link_to(event, true) %></p>
  <%- end -%>
  
  <p class="meta">
      <%= Event.human_attribute_name :created_by %>
      <%= event.created_by %>, <%= l event.created_at -%>
      <%- if event.created_at != event.updated_at -%>
        <br><%= Event.human_attribute_name :updated_by %>
        <%= event.updated_by %>, <%= l event.updated_at -%>
      <%- end -%>
    </p>
  <%- end -%>
</div>

<%- if event.respond_to?(:participants) && current_user == User.secretary -%>
  <%= form_tag external_event_path(event), method: :get, class: 'search icon' do %>
  <p>
    <%= text_field_tag :search, params[:search], class: 'jqueryui_input_classes', placeholder: t('helpers.label.user.search_placeholder') , data: {autocomplete_source: search_users_path}, id: "srch_fld"  %>
    <%= submit_tag 'Suchen', name: nil, id: "srch_btn" %>
  </p>
<%- end -%>

<% if event.respond_to?(:participants) && @users && @users.count > 0 %>
  <table class='autolink'>
    <tr>
      <th><%= User.human_attribute_name(:matriculation_number) %></th>
      <th><%= User.human_attribute_name(:lastname) %></th>
      <th><%= User.human_attribute_name(:firstname) %></th>
      <th><%= User.human_attribute_name(:phone) %></th>
      <th><%= User.human_attribute_name(:mobile) %></th>
      <th></th>
    </tr>
    <% @users.each do |user| %>
    <tr>
      <td><%= user.matriculation_number %></td>
      <td><%= dash(user.lastname) %></td>
      <td><%= dash(user.firstname) %></td>
      <td><%= dash(user.private_address.try :phone) %></td>
      <td><%= dash(user.private_address.try :mobile) %></td>
      <td>
        <%= image_link_tag_helper 'add',  external_event_add_me_path(event, :user => user)            if can?(:show, user) %>
      </td>
    </tr>
    <% end %>
  </table>
  <%- elsif event.respond_to?(:participants) && @searched -%>
<p>Keine Mitglieder gefunden.</p>
<%- end -%>
<%- end -%>

<% if event.try(:participants).try(:count)  && event.try(:participants).try(:count) > 0 %>
  <h3>Teilnehmende Brüder</h3>
  <table>
    <tr>
      <th><%= User.human_attribute_name(:lastname) %></th>
      <th><%= User.human_attribute_name(:firstname) %></th>
      <th><%= User.human_attribute_name(:phone) %></th>
      <th><%= User.human_attribute_name(:mobile) %></th>
      <th>Status</th>
      <th></th>
    </tr>
    <% event.participants.each do |participant| %>
      <tr>
        <td><%= dash(participant.lastname) %></td>
        <td><%= dash(participant.firstname) %></td>
        <td><%= dash(participant.private_address.try :phone) %></td>
        <td><%= dash(participant.private_address.try :mobile) %></td>
        <td><%= participant.subscription_status(event) %></td>
        <td>
          <%- if participant.subscribed_to_external_event?(event) && false == event.subscription_confirmed?(participant) -%>
          <%= link_to '<i class="success icon"></i>'.html_safe,  send("#{event.class.to_s.underscore}_confirm_subscription_path", event, :user => participant) unless event.subscription_confirmed?(participant) if can?(:confirm_subscription, "#{event.class}Participant".constantize.where(:external_event_id => event.id).where(:user_id => participant.id).first) %>
          <%- end -%>
          <%= destroy_link_to(send("#{event.class.to_s.underscore}_remove_me_path", event, :user => participant))  if can?(:destroy, "#{event.class}Participant".constantize.where(:external_event_id => event.id).where(:user_id => participant.id).first)|| (participant == current_user &&  false == event.subscription_confirmed?(participant)) %>
        </td>
      </tr>
    <% end %>
  </table>
<%- end -%>


