<ul>
  <%- if user_signed_in? -%>
    <li>
      <%= t("devise.information.signed_in_as", :user =>  current_user.email ) %>
    </li>
    <li>
      <%= link_to(t("devise.links.sign_out"), destroy_user_session_path) %>
    </li>
<li class="more space-top">
<ul>
  
  <% if can?(:create, Category) %>
    <%= content_tag :li, :class => (request.fullpath =~ /^\/categories$/ ? 'active' : nil) do %>
      <%= link_to(t("activerecord.models.cateories"), categories_path )%>
    <% end %>
  <% end %>

  <% Category.all.each do |cat| 
     next if([] == (cat.role_ids & current_user.role_ids))
     active = request.fullpath =~ /^\/categories\// 
     %>
      <%= content_tag :li, :class => (active ?  'active' : nil) do %>
        <%= link_to(cat.name, category_path(cat) )%>
        <% next unless active %>
      <% end %>
     
  <% end %>


  <%- else -%>
  <%= content_tag :li, link_to(t("links.pages.index"), root_url) %>
  <%= content_tag :li, link_to(t("devise.links.sign_in"), new_user_session_path) %>
  <%- end -%>
</ul>
</ul>

