<% title t("activerecord.models.external_event") + ": " + @external_event.title %>

<div class="event">
  <div class="date">
    <span class="month"><%= l(@external_event.date, format: '%b').upcase %></span>
    <span class="day"><%= l @external_event.date, format: '%d' %></span>
    <span class="dow"><%= l(@external_event.date, format: '%a').upcase %></span>
    <span class="year"><%= l @external_event.date, format: '%Y' %></span>
  </div>

  <h3>
    <span class="time"><%= l @external_event.time, format: :time %> Uhr:</span>
    <%= @external_event.title %>
  </h3>

  <p class="host icon"><%= dash(@external_event.host) %></p>
  <p class="map icon"><%= dash(@external_event.location) %> </p>
  <p class="public icon label"><%= ExternalEvent.human_attribute_name :description %>:</p>
  <%= simple_format dash(@external_event.description), class: 'description' %>

  <%- if @external_event.subscription_sent?(current_user)  -%>
    <p class="description , success icon">Angemeldet</p>
  <%- elsif (false == @external_event.subscription_sent?(current_user) && @external_event.subscribed?(current_user)) -%>
     <p class="description , spinner icon">Sekretär benachrichtigt</p>
  <%- else -%>
    <p class="description , add icon"><%= link_to "Teilnehmen", external_event_add_me_path(@external_event)%></p>
  <%- end -%>

  <%- if can?(:edit, @external_event) -%>
    <p class="description"><%= edit_link_to(@external_event, true) %></p>
  <%- end -%>
  <%- if can?(:edit, @external_event) -%>
    <p class="description"><%= destroy_link_to(@external_event, true) %></p>
  <%- end -%>

  <p class="meta">
    <%= Event.human_attribute_name :created_by %>
    <%= @external_event.created_by %>, <%= l @external_event.created_at -%>
    <%- if @external_event.created_at != @external_event.updated_at -%>
      <br><%= Event.human_attribute_name :updated_by %>
      <%= @external_event.updated_by %>, <%= l @external_event.updated_at -%>
    <%- end -%>
  </p>
</div>


<h3>Teilnehmende Brüder</h3>


<table>
<tr>
    <th>Name</th>
    <th>Status</th>
    <th></th>
  </tr>
<% @external_event.participants.each do |participant| %>
    <tr>
      <td><%= participant %></td>
      <td><%= participant.subscription_status(@external_event) %></td>
      </td>
      <td>
        <%= link_to '<i class="add icon"></i>'.html_safe, external_event_confirm_subscription_path(@external_event, :user => participant) unless @external_event.subscription_sent?(participant) if can?(:confirm_subscription, ExternalEventParticipant.where(:external_event_id => @external_event.id).where(:user_id => participant.id).first) %>
        
        <%=destroy_link_to(external_event_remove_me_path(@external_event, :user => participant))  if can?(:destroy, ExternalEventParticipant.where(:external_event_id => @external_event.id).where(:user_id => participant.id).first)|| (participant == current_user &&  false == @external_event.subscription_sent?(participant)) %>
      </td>
    </tr>
  <% end %>


</table>
